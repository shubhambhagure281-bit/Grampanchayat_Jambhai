<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    tools:context=".activities.AdminDashboardActivity">

    <!-- Top App Bar -->
    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/topAppBar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@color/primary_dark"
            app:title="ग्रामपंचायत प्रशासन डॅशबोर्ड"
            app:titleTextColor="@color/white" />

    </com.google.android.material.appbar.AppBarLayout>

    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/swipeRefresh"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="@dimen/spacing_medium">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- Welcome Admin Banner Card -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/spacing_medium"
                    app:cardBackgroundColor="@color/primary_dark"
                    app:cardCornerRadius="@dimen/card_corner_radius"
                    app:cardElevation="@dimen/card_elevation">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/spacing_medium">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="प्रशासक लॉगिन"
                            android:textColor="@color/secondary_light"
                            android:textSize="@dimen/text_size_caption"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvAdminName"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="@string/loading"
                            android:textColor="@color/white"
                            android:textSize="@dimen/text_size_headline"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="ग्रामपंचायत व्यवस्थापन व आकडेवारी केंद्र"
                            android:textColor="@color/surface_variant"
                            android:textSize="@dimen/text_size_body_small" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Section 1: Dynamic Statistics Counts from Firestore -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/spacing_small"
                    android:text="ग्रामपंचायत आकडेवारी (Live Stats)"
                    android:textColor="@color/primary"
                    android:textSize="@dimen/text_size_title"
                    android:textStyle="bold" />

                <!-- 7 Stat Cards Grid -->
                <GridLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:columnCount="2"
                    android:useDefaultMargins="true">

                    <!-- 1. Total Complaints -->
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/cardTotalComplaints"
                        android:layout_width="0dp"
                        android:layout_height="80dp"
                        android:layout_columnWeight="1"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackground"
                        app:cardCornerRadius="@dimen/card_corner_radius_small"
                        app:cardElevation="@dimen/card_elevation">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:gravity="center"
                            android:orientation="vertical"
                            android:padding="@dimen/spacing_small">

                            <TextView
                                android:id="@+id/tvTotalComplaintsCount"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="0"
                                android:textColor="@color/primary"
                                android:textSize="@dimen/text_size_headline"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="एकूण तक्रारी"
                                android:textColor="@color/gray_600"
                                android:textSize="@dimen/text_size_caption" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <!-- 2. Pending Complaints -->
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/cardPendingComplaints"
                        android:layout_width="0dp"
                        android:layout_height="80dp"
                        android:layout_columnWeight="1"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackground"
                        app:cardCornerRadius="@dimen/card_corner_radius_small"
                        app:cardElevation="@dimen/card_elevation">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:gravity="center"
                            android:orientation="vertical"
                            android:padding="@dimen/spacing_small">

                            <TextView
                                android:id="@+id/tvPendingComplaintsCount"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="0"
                                android:textColor="@color/status_pending"
                                android:textSize="@dimen/text_size_headline"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="प्रलंबित"
                                android:textColor="@color/gray_600"
                                android:textSize="@dimen/text_size_caption" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <!-- 3. In Progress Complaints -->
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/cardInProgressComplaints"
                        android:layout_width="0dp"
                        android:layout_height="80dp"
                        android:layout_columnWeight="1"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackground"
                        app:cardCornerRadius="@dimen/card_corner_radius_small"
                        app:cardElevation="@dimen/card_elevation">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:gravity="center"
                            android:orientation="vertical"
                            android:padding="@dimen/spacing_small">

                            <TextView
                                android:id="@+id/tvInProgressComplaintsCount"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="0"
                                android:textColor="@color/secondary"
                                android:textSize="@dimen/text_size_headline"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="प्रक्रियेत"
                                android:textColor="@color/gray_600"
                                android:textSize="@dimen/text_size_caption" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <!-- 4. Resolved Complaints -->
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/cardResolvedComplaints"
                        android:layout_width="0dp"
                        android:layout_height="80dp"
                        android:layout_columnWeight="1"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackground"
                        app:cardCornerRadius="@dimen/card_corner_radius_small"
                        app:cardElevation="@dimen/card_elevation">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:gravity="center"
                            android:orientation="vertical"
                            android:padding="@dimen/spacing_small">

                            <TextView
                                android:id="@+id/tvResolvedComplaintsCount"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="0"
                                android:textColor="@color/status_resolved"
                                android:textSize="@dimen/text_size_headline"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="निराकरण झाले"
                                android:textColor="@color/gray_600"
                                android:textSize="@dimen/text_size_caption" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <!-- 5. Notices Count -->
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/cardNoticesCount"
                        android:layout_width="0dp"
                        android:layout_height="80dp"
                        android:layout_columnWeight="1"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackground"
                        app:cardCornerRadius="@dimen/card_corner_radius_small"
                        app:cardElevation="@dimen/card_elevation">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:gravity="center"
                            android:orientation="vertical"
                            android:padding="@dimen/spacing_small">

                            <TextView
                                android:id="@+id/tvNoticesCount"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="0"
                                android:textColor="@color/primary"
                                android:textSize="@dimen/text_size_headline"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="सूचना"
                                android:textColor="@color/gray_600"
                                android:textSize="@dimen/text_size_caption" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <!-- 6. Schemes Count -->
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/cardSchemesCount"
                        android:layout_width="0dp"
                        android:layout_height="80dp"
                        android:layout_columnWeight="1"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackground"
                        app:cardCornerRadius="@dimen/card_corner_radius_small"
                        app:cardElevation="@dimen/card_elevation">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:gravity="center"
                            android:orientation="vertical"
                            android:padding="@dimen/spacing_small">

                            <TextView
                                android:id="@+id/tvSchemesCount"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="0"
                                android:textColor="@color/tertiary"
                                android:textSize="@dimen/text_size_headline"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="योजना"
                                android:textColor="@color/gray_600"
                                android:textSize="@dimen/text_size_caption" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <!-- 7. Users Count -->
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/cardUsersCount"
                        android:layout_width="0dp"
                        android:layout_height="80dp"
                        android:layout_columnSpan="2"
                        android:layout_columnWeight="2"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackground"
                        app:cardCornerRadius="@dimen/card_corner_radius_small"
                        app:cardElevation="@dimen/card_elevation">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:gravity="center"
                            android:orientation="horizontal"
                            android:padding="@dimen/spacing_small">

                            <TextView
                                android:id="@+id/tvUsersCount"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="0"
                                android:textColor="@color/primary"
                                android:textSize="@dimen/text_size_headline"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="@dimen/spacing_small"
                                android:text="नोंदणीकृत वापरकर्ते (Registered Users)"
                                android:textColor="@color/gray_800"
                                android:textSize="@dimen/text_size_body"
                                android:textStyle="bold" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                </GridLayout>

                <!-- Section 2: Admin Menu Options -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_medium"
                    android:layout_marginBottom="@dimen/spacing_small"
                    android:text="प्रशासकीय मेनू (Admin Menu)"
                    android:textColor="@color/primary"
                    android:textSize="@dimen/text_size_title"
                    android:textStyle="bold" />

                <!-- 6 Admin Menu Items Grid -->
                <GridLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:columnCount="2"
                    android:useDefaultMargins="true">

                    <!-- 1. Complaint Management -->
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/cardManageComplaints"
                        android:layout_width="0dp"
                        android:layout_height="100dp"
                        android:layout_columnWeight="1"
                        android:clickable="true"
                        android:focusable="true"
                        app:cardCornerRadius="@dimen/card_corner_radius"
                        app:cardElevation="@dimen/card_elevation">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:gravity="center"
                            android:orientation="vertical"
                            android:padding="@dimen/spacing_small">

                            <ImageView
                                android:layout_width="@dimen/icon_size_large"
                                android:layout_height="@dimen/icon_size_large"
                                android:contentDescription="@string/app_name"
                                android:src="@drawable/ic_complaint"
                                app:tint="@color/primary" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/spacing_tiny"
                                android:gravity="center"
                                android:text="१. तक्रार व्यवस्थापन"
                                android:textColor="@color/on_surface"
                                android:textSize="@dimen/text_size_body_small"
                                android:textStyle="bold" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <!-- 2. Notice Management -->
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/cardManageNotices"
                        android:layout_width="0dp"
                        android:layout_height="100dp"
                        android:layout_columnWeight="1"
                        android:clickable="true"
                        android:focusable="true"
                        app:cardCornerRadius="@dimen/card_corner_radius"
                        app:cardElevation="@dimen/card_elevation">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:gravity="center"
                            android:orientation="vertical"
                            android:padding="@dimen/spacing_small">

                            <ImageView
                                android:layout_width="@dimen/icon_size_large"
                                android:layout_height="@dimen/icon_size_large"
                                android:contentDescription="@string/app_name"
                                android:src="@drawable/ic_notice"
                                app:tint="@color/primary" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/spacing_tiny"
                                android:gravity="center"
                                android:text="२. सूचना व्यवस्थापन"
                                android:textColor="@color/on_surface"
                                android:textSize="@dimen/text_size_body_small"
                                android:textStyle="bold" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <!-- 3. Scheme Management -->
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/cardManageSchemes"
                        android:layout_width="0dp"
                        android:layout_height="100dp"
                        android:layout_columnWeight="1"
                        android:clickable="true"
                        android:focusable="true"
                        app:cardCornerRadius="@dimen/card_corner_radius"
                        app:cardElevation="@dimen/card_elevation">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:gravity="center"
                            android:orientation="vertical"
                            android:padding="@dimen/spacing_small">

                            <ImageView
                                android:layout_width="@dimen/icon_size_large"
                                android:layout_height="@dimen/icon_size_large"
                                android:contentDescription="@string/app_name"
                                android:src="@drawable/ic_scheme"
                                app:tint="@color/tertiary" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/spacing_tiny"
                                android:gravity="center"
                                android:text="३. योजना व्यवस्थापन"
                                android:textColor="@color/on_surface"
                                android:textSize="@dimen/text_size_body_small"
                                android:textStyle="bold" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <!-- 4. User Management -->
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/cardManageUsers"
                        android:layout_width="0dp"
                        android:layout_height="100dp"
                        android:layout_columnWeight="1"
                        android:clickable="true"
                        android:focusable="true"
                        app:cardCornerRadius="@dimen/card_corner_radius"
                        app:cardElevation="@dimen/card_elevation">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:gravity="center"
                            android:orientation="vertical"
                            android:padding="@dimen/spacing_small">

                            <ImageView
                                android:layout_width="@dimen/icon_size_large"
                                android:layout_height="@dimen/icon_size_large"
                                android:contentDescription="@string/app_name"
                                android:src="@drawable/ic_person"
                                app:tint="@color/primary" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/spacing_tiny"
                                android:gravity="center"
                                android:text="४. वापरकर्ता व्यवस्थापन"
                                android:textColor="@color/on_surface"
                                android:textSize="@dimen/text_size_body_small"
                                android:textStyle="bold" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <!-- 5. Panchayat Info -->
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/cardPanchayatInfo"
                        android:layout_width="0dp"
                        android:layout_height="100dp"
                        android:layout_columnWeight="1"
                        android:clickable="true"
                        android:focusable="true"
                        app:cardCornerRadius="@dimen/card_corner_radius"
                        app:cardElevation="@dimen/card_elevation">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:gravity="center"
                            android:orientation="vertical"
                            android:padding="@dimen/spacing_small">

                            <ImageView
                                android:layout_width="@dimen/icon_size_large"
                                android:layout_height="@dimen/icon_size_large"
                                android:contentDescription="@string/app_name"
                                android:src="@drawable/ic_info"
                                app:tint="@color/primary" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/spacing_tiny"
                                android:gravity="center"
                                android:text="५. ग्रामपंचायत माहिती"
                                android:textColor="@color/on_surface"
                                android:textSize="@dimen/text_size_body_small"
                                android:textStyle="bold" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <!-- 6. Member Management -->
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/cardManageMembers"
                        android:layout_width="0dp"
                        android:layout_height="100dp"
                        android:layout_columnWeight="1"
                        android:clickable="true"
                        android:focusable="true"
                        app:cardCornerRadius="@dimen/card_corner_radius"
                        app:cardElevation="@dimen/card_elevation">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:gravity="center"
                            android:orientation="vertical"
                            android:padding="@dimen/spacing_small">

                            <ImageView
                                android:layout_width="@dimen/icon_size_large"
                                android:layout_height="@dimen/icon_size_large"
                                android:contentDescription="@string/app_name"
                                android:src="@drawable/ic_check"
                                app:tint="@color/secondary" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/spacing_tiny"
                                android:gravity="center"
                                android:text="६. सदस्य व्यवस्थापन"
                                android:textColor="@color/on_surface"
                                android:textSize="@dimen/text_size_body_small"
                                android:textStyle="bold" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <!-- 7. Gallery Management -->
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/cardManageGallery"
                        android:layout_width="0dp"
                        android:layout_height="80dp"
                        android:layout_columnSpan="2"
                        android:layout_columnWeight="2"
                        android:clickable="true"
                        android:focusable="true"
                        app:cardCornerRadius="@dimen/card_corner_radius"
                        app:cardElevation="@dimen/card_elevation">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:gravity="center"
                            android:orientation="horizontal"
                            android:padding="@dimen/spacing_medium">

                            <ImageView
                                android:layout_width="@dimen/icon_size_large"
                                android:layout_height="@dimen/icon_size_large"
                                android:contentDescription="@string/app_name"
                                android:src="@drawable/ic_work"
                                app:tint="@color/primary" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="@dimen/spacing_small"
                                android:gravity="center"
                                android:text="७. ग्रामपंचायत फोटो गॅलरी व्यवस्थापन"
                                android:textColor="@color/on_surface"
                                android:textSize="@dimen/text_size_body"
                                android:textStyle="bold" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                </GridLayout>

                <!-- Logout Button -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnAdminLogout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_large"
                    android:backgroundTint="@color/status_rejected"
                    android:text="प्रशासन लॉगआउट करा" />

            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>