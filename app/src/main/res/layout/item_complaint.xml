<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/spacing_small"
    android:clickable="true"
    android:focusable="true"
    app:cardCornerRadius="@dimen/card_corner_radius_small"
    app:cardElevation="@dimen/card_elevation">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/spacing_medium">

        <!-- Top Header: Complaint ID & Status Badge -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvComplaintId"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="@color/primary"
                android:textSize="@dimen/text_size_subtitle"
                android:textStyle="bold" />

            <!-- Status Pill Badge -->
            <TextView
                android:id="@+id/tvComplaintStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_status_pending"
                android:textColor="@color/status_pending"
                android:textSize="@dimen/text_size_caption"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Complaint Type -->
        <TextView
            android:id="@+id/tvComplaintType"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_tiny"
            android:textColor="@color/secondary"
            android:textSize="@dimen/text_size_body"
            android:textStyle="bold" />

        <!-- Description Snippet -->
        <TextView
            android:id="@+id/tvComplaintDescription"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_tiny"
            android:ellipsize="end"
            android:maxLines="2"
            android:textColor="@color/on_surface"
            android:textSize="@dimen/text_size_body_small" />

        <!-- Date -->
        <TextView
            android:id="@+id/tvComplaintDate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_small"
            android:textColor="@color/gray_600"
            android:textSize="@dimen/text_size_caption" />

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>