<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base Application Material 3 Theme -->
    <style name="Base.Theme.GrampanchayatJambhai" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Default Brand Primary Colors -->
        <item name="colorPrimary">@color/primary</item>
        <item name="colorOnPrimary">@color/on_primary</item>
        <item name="colorPrimaryContainer">@color/surface_variant</item>
        <item name="colorOnPrimaryContainer">@color/primary_dark</item>

        <!-- Brand Secondary Colors -->
        <item name="colorSecondary">@color/secondary</item>
        <item name="colorOnSecondary">@color/on_secondary</item>

        <!-- Background & Surface Colors -->
        <item name="android:colorBackground">@color/background</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/on_surface</item>
        <item name="colorSurfaceVariant">@color/surface_variant</item>
        <item name="colorOnSurfaceVariant">@color/on_surface_variant</item>

        <!-- Official Mukta Devanagari Font Family -->
        <item name="fontFamily">@font/mukta_font_family</item>
        <item name="android:fontFamily">@font/mukta_font_family</item>
        <item name="textAppearanceHeadlineLarge">@style/TextAppearance.Grampanchayat.Headline</item>
        <item name="textAppearanceTitleMedium">@style/TextAppearance.Grampanchayat.Title</item>
        <item name="textAppearanceBodyMedium">@style/TextAppearance.Grampanchayat.Body</item>

        <!-- Status Bar Configuration -->
        <item name="android:statusBarColor">@color/primary_dark</item>
        <item name="android:windowLightStatusBar">false</item>

        <!-- Common Component Styles -->
        <item name="materialCardViewStyle">@style/Widget.Grampanchayat.CardView</item>
        <item name="materialButtonStyle">@style/Widget.Grampanchayat.Button.Primary</item>
        <item name="textInputStyle">@style/Widget.Grampanchayat.TextInputLayout</item>
    </style>

    <style name="Theme.GrampanchayatJambhai" parent="Base.Theme.GrampanchayatJambhai" />

    <!-- 12 Dynamic Color Pattern Themes -->
    <!-- 1. Green (Default) -->
    <style name="Theme.GrampanchayatJambhai.Green" parent="Base.Theme.GrampanchayatJambhai">
        <item name="colorPrimary">@color/theme_green_primary</item>
        <item name="colorSecondary">@color/theme_green_secondary</item>
        <item name="android:statusBarColor">@color/theme_green_dark</item>
    </style>

    <!-- 2. Royal Blue -->
    <style name="Theme.GrampanchayatJambhai.Blue" parent="Base.Theme.GrampanchayatJambhai">
        <item name="colorPrimary">@color/theme_blue_primary</item>
        <item name="colorSecondary">@color/theme_blue_secondary</item>
        <item name="android:statusBarColor">@color/theme_blue_dark</item>
    </style>

    <!-- 3. Saffron Sunset -->
    <style name="Theme.GrampanchayatJambhai.Saffron" parent="Base.Theme.GrampanchayatJambhai">
        <item name="colorPrimary">@color/theme_saffron_primary</item>
        <item name="colorSecondary">@color/theme_saffron_secondary</item>
        <item name="android:statusBarColor">@color/theme_saffron_dark</item>
    </style>

    <!-- 4. Deep Purple -->
    <style name="Theme.GrampanchayatJambhai.Purple" parent="Base.Theme.GrampanchayatJambhai">
        <item name="colorPrimary">@color/theme_purple_primary</item>
        <item name="colorSecondary">@color/theme_purple_secondary</item>
        <item name="android:statusBarColor">@color/theme_purple_dark</item>
    </style>

    <!-- 5. Teal Cyan -->
    <style name="Theme.GrampanchayatJambhai.Teal" parent="Base.Theme.GrampanchayatJambhai">
        <item name="colorPrimary">@color/theme_teal_primary</item>
        <item name="colorSecondary">@color/theme_teal_secondary</item>
        <item name="android:statusBarColor">@color/theme_teal_dark</item>
    </style>

    <!-- 6. Crimson Red -->
    <style name="Theme.GrampanchayatJambhai.Red" parent="Base.Theme.GrampanchayatJambhai">
        <item name="colorPrimary">@color/theme_red_primary</item>
        <item name="colorSecondary">@color/theme_red_secondary</item>
        <item name="android:statusBarColor">@color/theme_red_dark</item>
    </style>

    <!-- 7. Indigo Night -->
    <style name="Theme.GrampanchayatJambhai.Indigo" parent="Base.Theme.GrampanchayatJambhai">
        <item name="colorPrimary">@color/theme_indigo_primary</item>
        <item name="colorSecondary">@color/theme_indigo_secondary</item>
        <item name="android:statusBarColor">@color/theme_indigo_dark</item>
    </style>

    <!-- 8. Emerald Mint -->
    <style name="Theme.GrampanchayatJambhai.Emerald" parent="Base.Theme.GrampanchayatJambhai">
        <item name="colorPrimary">@color/theme_emerald_primary</item>
        <item name="colorSecondary">@color/theme_emerald_secondary</item>
        <item name="android:statusBarColor">@color/theme_emerald_dark</item>
    </style>

    <!-- 9. Golden Amber -->
    <style name="Theme.GrampanchayatJambhai.Amber" parent="Base.Theme.GrampanchayatJambhai">
        <item name="colorPrimary">@color/theme_amber_primary</item>
        <item name="colorSecondary">@color/theme_amber_secondary</item>
        <item name="android:statusBarColor">@color/theme_amber_dark</item>
    </style>

    <!-- 10. Kokum Maroon -->
    <style name="Theme.GrampanchayatJambhai.Maroon" parent="Base.Theme.GrampanchayatJambhai">
        <item name="colorPrimary">@color/theme_maroon_primary</item>
        <item name="colorSecondary">@color/theme_maroon_secondary</item>
        <item name="android:statusBarColor">@color/theme_maroon_dark</item>
    </style>

    <!-- 11. Ocean Blue -->
    <style name="Theme.GrampanchayatJambhai.Ocean" parent="Base.Theme.GrampanchayatJambhai">
        <item name="colorPrimary">@color/theme_ocean_primary</item>
        <item name="colorSecondary">@color/theme_ocean_secondary</item>
        <item name="android:statusBarColor">@color/theme_ocean_dark</item>
    </style>

    <!-- 12. Charcoal Gray -->
    <style name="Theme.GrampanchayatJambhai.Charcoal" parent="Base.Theme.GrampanchayatJambhai">
        <item name="colorPrimary">@color/theme_charcoal_primary</item>
        <item name="colorSecondary">@color/theme_charcoal_secondary</item>
        <item name="android:statusBarColor">@color/theme_charcoal_dark</item>
    </style>

    <!-- Card View Common Style -->
    <style name="Widget.Grampanchayat.CardView" parent="Widget.Material3.CardView.Elevated">
        <item name="cardCornerRadius">@dimen/card_corner_radius</item>
        <item name="cardElevation">@dimen/card_elevation</item>
        <item name="cardBackgroundColor">?attr/colorSurface</item>
        <item name="strokeColor">@color/outline_variant</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <!-- Primary Button Common Style -->
    <style name="Widget.Grampanchayat.Button.Primary" parent="Widget.Material3.Button">
        <item name="backgroundTint">?attr/colorPrimary</item>
        <item name="android:textColor">@color/on_primary</item>
        <item name="cornerRadius">@dimen/button_corner_radius</item>
        <item name="android:minHeight">@dimen/button_height</item>
        <item name="android:textSize">@dimen/text_size_subtitle</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- Outlined Button Common Style -->
    <style name="Widget.Grampanchayat.Button.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="strokeColor">?attr/colorPrimary</item>
        <item name="android:textColor">?attr/colorPrimary</item>
        <item name="cornerRadius">@dimen/button_corner_radius</item>
        <item name="android:minHeight">@dimen/button_height</item>
        <item name="android:textSize">@dimen/text_size_subtitle</item>
    </style>

    <!-- Text Input Layout Common Style -->
    <style name="Widget.Grampanchayat.TextInputLayout" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusTopStart">@dimen/input_corner_radius</item>
        <item name="boxCornerRadiusTopEnd">@dimen/input_corner_radius</item>
        <item name="boxCornerRadiusBottomStart">@dimen/input_corner_radius</item>
        <item name="boxCornerRadiusBottomEnd">@dimen/input_corner_radius</item>
        <item name="boxStrokeColor">?attr/colorPrimary</item>
        <item name="hintTextColor">?attr/colorPrimary</item>
    </style>

    <!-- Bottom Navigation Styles -->
    <style name="Widget.Grampanchayat.BottomNavText" parent="TextAppearance.Material3.LabelSmall">
        <item name="android:textSize">11sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Widget.Grampanchayat.BottomNavIndicator" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:color">#E8F5E9</item>
        <item name="android:width">44dp</item>
        <item name="android:height">24dp</item>
    </style>

    <!-- Devanagari Typography Styles -->
    <style name="TextAppearance.Grampanchayat.Headline" parent="TextAppearance.Material3.HeadlineMedium">
        <item name="fontFamily">@font/mukta_font_family</item>
        <item name="android:fontFamily">@font/mukta_font_family</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">#1A1C1A</item>
    </style>

    <style name="TextAppearance.Grampanchayat.Title" parent="TextAppearance.Material3.TitleMedium">
        <item name="fontFamily">@font/mukta_font_family</item>
        <item name="android:fontFamily">@font/mukta_font_family</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">#176B2C</item>
    </style>

    <style name="TextAppearance.Grampanchayat.Body" parent="TextAppearance.Material3.BodyMedium">
        <item name="fontFamily">@font/mukta_font_family</item>
        <item name="android:fontFamily">@font/mukta_font_family</item>
        <item name="android:textColor">#202124</item>
    </style>
</resources>