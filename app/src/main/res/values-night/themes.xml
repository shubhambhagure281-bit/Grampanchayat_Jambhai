<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base Application Material 3 Dark Theme -->
    <style name="Base.Theme.GrampanchayatJambhai" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Background & Surface Colors for Dark Mode -->
        <item name="android:colorBackground">#121212</item>
        <item name="colorSurface">#1E1E1E</item>
        <item name="colorOnSurface">#E2E2E2</item>
        <item name="colorSurfaceVariant">#2C2C2C</item>
        <item name="colorOnSurfaceVariant">#C5C5C5</item>

        <!-- Status Bar Configuration -->
        <item name="android:statusBarColor">#000000</item>
        <item name="android:windowLightStatusBar">false</item>

        <!-- Common Component Styles -->
        <item name="materialCardViewStyle">@style/Widget.Grampanchayat.CardView</item>
        <item name="materialButtonStyle">@style/Widget.Grampanchayat.Button.Primary</item>
        <item name="textInputStyle">@style/Widget.Grampanchayat.TextInputLayout</item>
    </style>
</resources>