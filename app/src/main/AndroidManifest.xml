            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Admin Complaint Details Activity -->
        <activity
            android:name=".activities.AdminComplaintDetailsActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Admin Notice Management Activity -->
        <activity
            android:name=".activities.AdminNoticeManagementActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Admin Add/Edit Notice Activity -->
        <activity
            android:name=".activities.AdminAddEditNoticeActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Admin Scheme Management Activity -->
        <activity
            android:name=".activities.AdminSchemeManagementActivity"
